generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Login da equipe — nasceu como login único (você) e virou multiusuário.
// master = você: acesso total, nunca é restringido por nenhuma capacidade abaixo.
// Quem não é master só enxerga/faz o que as capacidades individuais permitirem —
// são por pessoa (não por "cargo padrão"), então dois "Editor" podem ter acessos
// diferentes entre si. `cargo` aqui é só um rótulo livre (aparece na tela, não
// controla nada sozinho).
model Usuario {
  id               String    @id @default(uuid())
  email            String    @unique
  senha            String
  nome             String
  cargo            String    @default("Adm Master") // rótulo livre: "Editor", "Gestor de Tráfego" etc.
  master           Boolean   @default(true) // true só quem tem acesso total e não pode ser restringido
  ativo            Boolean   @default(true) // false = login desativado, sem excluir o histórico da pessoa

  // Capacidades — cada uma liga uma área do sistema. Ignoradas (sempre liberado) se master=true.
  verFinanceiro          Boolean @default(false) // vê a área Financeiro e valores em R$ pelo resto do app
  gerenciarFinanceiro    Boolean @default(false) // lançar/editar cobrança, despesa, conta a pagar/receber
  // legado: era um único interruptor pros 4 de baixo juntos ("Comercial"). Mantido
  // só por compatibilidade — quem já tinha isso ligado continua com os 4 liberados
  // (ver permissoesDe, que soma esse flag em cada um). O formulário de equipe não
  // usa mais esse campo pra gente nova: grava direto nos 4 específicos abaixo.
  verComercial           Boolean @default(false)
  verOportunidades       Boolean @default(false) // funil de Oportunidades
  verOrcamentos          Boolean @default(false) // Orçamentos (painel e aba do cliente)
  verContratos           Boolean @default(false) // Contratos (painel e aba do cliente)
  verCatalogo            Boolean @default(false) // Catálogo de serviços e Pacotes
  gerenciarTrafego       Boolean @default(false) // módulo Tráfego Pago
  gerenciarEquipe        Boolean @default(false) // Configurações > Equipe (criar/editar outros logins)
  gerenciarConfiguracoes Boolean @default(false) // resto de Configurações (site, catálogo, automações etc.)
  verArquivos            Boolean @default(false) // vê a aba "Arquivos" (pastas do Drive) dentro do cliente
  // false = dentro de um cliente, só vê Arquivos (se verArquivos) e Horas — as abas gerais
  // (Visão Geral, Contatos, Onboarding, Solicitações, Tarefas, Entregas, Serviços, Links) ficam ocultas.
  // Default true pra não mudar nada de quem já existe; só fica false quando alguém liga
  // isso de propósito (ex: preset "Editor" em Equipe) pra um acesso bem restrito.
  acessoClienteCompleto  Boolean @default(true)
  todosClientes          Boolean @default(true) // false = só enxerga os clientes listados em clientesPermitidos

  // Perfil pessoal (redesign v144, Parte 3) — cada pessoa edita o próprio, em
  // Configurações pessoais (/dashboard/perfil), sem precisar de gerenciarEquipe.
  fotoUrl String?
  links   LinkUsuario[]

  clientesPermitidos ClienteUsuario[]
  registrosTempo     RegistroTempo[]
  // Tarefas atribuídas a essa pessoa (redesign v144, Parte 2) — opcional, campo
  // novo (Tarefa não tinha responsável nenhum antes). Ver Tarefa.responsavelId.
  tarefasResponsavel Tarefa[] @relation("TarefaResponsavel")

  // Tarefas onde essa pessoa é a responsável pelo DESBLOQUEIO (Etapa 1 v152) — ver
  // Tarefa.bloqueioResponsavelId. Relação nomeada à parte de tarefasResponsavel
  // porque as duas apontam pra Usuario a partir de Tarefa.
  tarefasBloqueioResponsavel Tarefa[] @relation("TarefaBloqueioResponsavel")
  // Comentários internos que essa pessoa escreveu em tarefas (Etapa 1 v152).
  comentariosTarefa ComentarioTarefa[]
  // Linhas de histórico geradas por alterações que essa pessoa fez em tarefas
  // (Etapa 1 v152) — opcional, mesmo padrão de RegistroTempo.usuarioId.
  historicoTarefaAlteracoes HistoricoTarefa[]
  // Notificações internas (Etapa 1 v152): a caixa de entrada dela (destinatário) e,
  // à parte, as que ela mesma originou (ex.: comentário que avisou outra pessoa).
  notificacoes        Notificacao[] @relation("NotificacaoDestinatario")
  notificacoesCriadas Notificacao[] @relation("NotificacaoCriadaPor")

  // Revisão e aprovação de conteúdo (Etapa 2 v153): versões que essa pessoa enviou
  // e comentários de revisão que escreveu. tarefasVideoBrutoExcecaoConcedida é
  // relação nomeada porque Usuario já aponta pra Tarefa de duas outras formas
  // (tarefasResponsavel, tarefasBloqueioResponsavel).
  versoesConteudoCriadas            VersaoConteudo[]    @relation("VersaoConteudoCriadaPor")
  comentariosRevisao                ComentarioRevisao[]
  tarefasVideoBrutoExcecaoConcedida Tarefa[]            @relation("TarefaVideoBrutoExcecaoPor")

  // Autoria no módulo de Tráfego Pago (v151) — mesmo padrão de RegistroTempo.usuarioId:
  // opcional, preenchido a partir da sessão em cada rota, nunca adivinhado.
  lotesImportacaoCriados    LoteImportacao[]
  movimentacoesVerbaCriadas MovimentacaoVerba[]
  campanhasAvaliadas        Campanha[]
  relatoriosTrafegoGerados  RelatorioTrafego[]

  // Linhas de histórico geradas por alterações que essa pessoa fez em serviços
  // contratados (Etapa 3 v157) — mesmo padrão opcional de historicoTarefaAlteracoes.
  historicoServicosContratados HistoricoServicoContratado[]

  // Capacidade da equipe (Etapa 4 v158) — "disponibilidade" é essa carga horária
  // semanal padrão (usada como 100% de capacidade em Comparar trabalho previsto x
  // disponível); "folgas e compromissos" são as linhas em Ausencia, que abatem
  // dessa base semana a semana. 40h (CLT) é só um chute inicial razoável pra quem
  // já existe — cada pessoa edita a própria em Configurações pessoais, e
  // gerenciarEquipe edita qualquer uma.
  cargaHorariaSemanal Float      @default(40)
  ausencias           Ausencia[]

  createdAt        DateTime  @default(now())
  tentativasFalhas Int       @default(0) // contador de senhas erradas seguidas — zera a cada acerto
  bloqueadoAte     DateTime? // se preenchido e no futuro, login fica bloqueado até essa hora (proteção contra força bruta)
}

// Folga, férias, atestado ou compromisso da equipe (Etapa 4 v158) — item
// "cadastrar disponibilidade, folgas e compromissos da equipe". Um período de 1
// dia só tem inicio=fim. `diaInteiro=true` (folga/férias/atestado, o normal)
// zera a capacidade daquele dia inteiro; `diaInteiro=false` (compromisso parcial,
// ex.: "reunião externa de manhã") abate só `horasPorDia` da capacidade daquele
// dia, sem zerar o resto. Ver lib/capacidade.ts pro cálculo semana a semana.
model Ausencia {
  id          String    @id @default(uuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo        String    @default("folga") // folga | ferias | atestado | compromisso
  inicio      DateTime
  fim         DateTime
  diaInteiro  Boolean   @default(true)
  horasPorDia Float? // obrigatório só quando diaInteiro=false
  descricao   String?
  createdAt   DateTime  @default(now())
}

// Links pessoais de contato (Discord, WhatsApp etc.) — mesmo formato de LinkCliente,
// editado pela própria pessoa em Configurações pessoais (redesign v144, Parte 3).
model LinkUsuario {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String // discord | whatsapp | instagram | email | outro
  label     String?
  url       String
  createdAt DateTime @default(now())
}

// Atribuição de cliente a um usuário não-master com todosClientes=false —
// só passa a enxergar aquele cliente (Clientes, Tarefas, Agenda, Horas) se estiver aqui.
model ClienteUsuario {
  id        String  @id @default(uuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  @@unique([usuarioId, clienteId])
}

model Cliente {
  id                 String    @id @default(uuid())
  nome               String
  whatsapp           String?
  cnpj               String?
  contatoNome        String?
  endereco           String?
  logoUrl            String?
  linkDrive          String?
  cor                String? // hex — usada como accent do cliente (badges, tarefas, agenda)
  status             String    @default("lead") // lead | ativo | inativo
  descontoMensal     Decimal   @default(0) // abatido do total dos serviços contratados
  acrescimoMensal    Decimal   @default(0) // somado ao total — pra cobrir serviços já combinados mas ainda não cadastrados
  prazoContratoMeses Int?
  dataInicioContrato DateTime? // marcado manualmente na aba Serviços — usado pra calcular a renovação
  valorRenovacao     Decimal?
  cobrancaRecorrenteAtiva Boolean @default(false)
  cobrancaRecorrenteInicio String? // AAAA-MM, definido ao ativar a mensalidade
  cobrancaDiaVencimento Int @default(5)
  formaPagamentoTrafego String? // cartao_credito | pix | boleto; somente a mídia, separado da mensalidade da agência
  exibirLogoPublico  Boolean   @default(false) // aparece na vitrine "empresas que confiam" das propostas
  createdAt          DateTime  @default(now())

  // Etapa 4 (v158) — "permitir suspender a geração [de rotinas mensais] quando o
  // contrato estiver pausado". Campo PRÓPRIO, separado de `status`, de propósito:
  // `status` já tem 15+ lugares no código checando "ativo" pra outras coisas
  // (cobrança, contagem de clientes ativos, filtros de listagem...) — um cliente
  // pode estar "ativo" (contrato valendo, mensalidade cobrando normal) e ainda
  // assim ter pedido pra pausar só a produção de conteúdo por um tempo, sem que
  // isso mude mais nada no resto do app. Default false — nunca afeta quem já existe.
  rotinasPausadas Boolean @default(false)

  // Pastas da automação de pastas do Google Drive (raiz do cliente + 3 fixas dentro
  // dela). Ficam null até a 1ª vez que alguém abre a aba Arquivos desse cliente (ou
  // até a 1ª tarefa de conteúdo com prazo ser criada) — não são criadas em massa pra
  // todo cliente que existe, só sob demanda (ver lib/google.ts: garantirPastasCliente).
  // Logotipos e Conteúdo ganham permissão "qualquer um com o link" na criação;
  // Contratos nunca ganha essa permissão, de propósito — fica só na conta do Drive
  // da agência mesmo.
  driveClienteFolderId   String?
  driveLogotiposFolderId String?
  driveContratosFolderId String?
  driveConteudoFolderId  String?

  tarefas             Tarefa[]
  orcamentos          Orcamento[]
  contratos           Contrato[]
  cobrancas           Cobranca[]
  despesas            Despesa[]
  servicosContratados ServicoContratado[]
  registrosTempo      RegistroTempo[]
  redesGerenciadas    String[] @default([]) // instagram | tiktok | facebook | google | meta_ads
  relatorios          RelatorioPeriodo[]
  contatos            Contato[]
  links               LinkCliente[]
  onboarding          Onboarding?
  solicitacoes        Solicitacao[]
  rotinasGeradas      RotinaGerada[]
  usuariosPermitidos  ClienteUsuario[]
  campanhas           Campanha[]

  // Módulo de Tráfego Pago (v151) — verba/saldo é controle interno da agência,
  // sem ligação com Financeiro (ver comentário no model Campanha).
  retornosTrafego     RetornoMensalTrafego[]
  verbaTrafego        VerbaTrafego?
  lotesImportacao     LoteImportacao[]
  relatoriosTrafego   RelatorioTrafego[]

  // Notificações internas vinculadas a esse cliente (Etapa 1 v152) — ex.:
  // comentário de relatório, tarefa bloqueada de um conteúdo dele etc.
  notificacoes Notificacao[]
  cronogramas CronogramaCliente[]
}

// Relatório de performance por rede e por período — dado lançado manualmente (Fase 1).
model RelatorioPeriodo {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  rede        String // instagram | tiktok | facebook | google | meta_ads
  inicio      DateTime
  fim         DateTime

  seguidoresInicio     Int?
  seguidoresFim        Int?
  alcance              Int?
  impressoes           Int?
  curtidas             Int?
  comentariosQtd       Int?
  compartilhamentos    Int?
  salvamentos          Int?
  visualizacoes        Int?
  postsPublicados      Int?
  reelsPublicados      Int?

  investimento Decimal?
  cliques      Int?
  leads        Int?

  comentarioAgencia String?
  comentarioCliente String?
  // Preenchido/atualizado sozinho sempre que comentarioCliente muda (rota pública
  // de PATCH) — permite saber se é um comentário NOVO, pra notificar (Etapa 1
  // v152), sem comparar strings toda vez.
  comentarioClienteEm DateTime?

  createdAt DateTime @default(now())

  // Notificações internas geradas a partir de um comentário de cliente nesse
  // relatório (Etapa 1 v152) — ver Notificacao.
  notificacoes Notificacao[]
}

// Contatos adicionais do cliente — o campo antigo Cliente.contatoNome continua existindo
// e funcionando (é o "contato principal" implícito de quem tinha só um), isso aqui é aditivo.
model Contato {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  nome         String
  cargo        String?
  telefone     String?
  whatsapp     String?
  email        String?
  observacoes  String?

  principal          Boolean @default(false)
  financeiro         Boolean @default(false)
  aprovacaoConteudo  Boolean @default(false)
  contratos          Boolean @default(false)

  createdAt DateTime @default(now())

  // Revisão e aprovação de conteúdo (Etapa 2 v153) — aprovações registradas em
  // nome desse contato e comentários que ele escreveu na página pública de
  // revisão. aprovacaoConteudo acima é só um rótulo informativo (não trava nada
  // sozinho); qualquer contato pode aprovar/comentar, esse marcador só ajuda a
  // equipe a saber com quem falar.
  aprovacoes         VersaoConteudo[]
  comentariosRevisao ComentarioRevisao[]

  // Pedidos feitos pelo formulário público de solicitação em nome desse contato
  // (Etapa 3 v157) — ver Solicitacao.solicitanteContatoId.
  solicitacoes Solicitacao[]
}

// Links e referências do cliente (Drive, Canva, redes sociais, etc) — Cliente.linkDrive
// continua existindo e funcionando, isso aqui é uma lista adicional mais completa.
model LinkCliente {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  tipo      String // drive | canva | site | instagram | tiktok | meta_business | google_ads | linktree | brandbook | fotos | videos | outro
  label     String?
  url       String
  createdAt DateTime @default(now())
}

// Onboarding — checklist do começo de um cliente novo, até ficar operacional de verdade.
// Tempo lançado em cada item vira um RegistroTempo de verdade (módulo Horas já existente),
// sem duplicar dado — ver ItemOnboarding.registroTempoId.
model Onboarding {
  id          String   @id @default(uuid())
  clienteId   String   @unique
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  dataInicio  DateTime @default(now())
  status      String   @default("em_andamento") // em_andamento | concluido
  itens       ItemOnboarding[]
  createdAt   DateTime @default(now())
}

model ItemOnboarding {
  id             String     @id @default(uuid())
  onboardingId   String
  onboarding     Onboarding @relation(fields: [onboardingId], references: [id])
  titulo         String
  responsavel    String     @default("agencia") // agencia | cliente | terceiro
  status         String     @default("pendente") // pendente | concluido | bloqueado
  observacao     String?
  registroTempoId String? // aponta pro RegistroTempo criado quando lança tempo nesse item
  dataConclusao  DateTime?
  ordem          Int        @default(0)
  createdAt      DateTime   @default(now())
}

// Baixa/pagamento parcial de uma cobrança ou despesa — permite quitar aos poucos.
// O status "atrasado" não é mais escolhido manualmente daqui pra frente: é calculado
// (vencimento passou + ainda tem saldo em aberto) — ver lib/statusFinanceiro.ts.
model Pagamento {
  id          String    @id @default(uuid())
  cobrancaId  String?
  cobranca    Cobranca? @relation(fields: [cobrancaId], references: [id])
  despesaId   String?
  despesa     Despesa?  @relation(fields: [despesaId], references: [id])
  valor       Decimal
  data        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

// Pipeline comercial simples — existe ANTES de virar Cliente (evita duplicar cadastro:
// ao ganhar, gera o Cliente e liga aqui via clienteId, nunca cria dois registros soltos).
model Oportunidade {
  id              String    @id @default(uuid())
  nome            String // empresa ou pessoa
  contatoNome     String?
  contatoWhatsapp String?
  origem          String? // indicação, instagram, site, evento...
  interesse       String? // o que a pessoa quer
  valorEstimado   Decimal?
  status          String    @default("novo_lead")
  // novo_lead | contato_feito | reuniao | proposta_enviada | negociacao | ganho | perdido
  proximaAcao     String?
  dataProximaAcao DateTime?
  observacoes     String?
  motivoPerda     String?
  clienteId       String? // preenchido quando ganha e vira Cliente de verdade
  createdAt       DateTime  @default(now())
}

// Pedido do cliente que chega fora do fluxo normal — "faz isso pra mim", "preciso de..."
model Solicitacao {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  descricao   String
  prioridade  String   @default("media") // baixa | media | alta
  status      String   @default("pendente") // pendente | em_andamento | concluida
  extra       Boolean  @default(false) // true = fora do escopo contratado, pode precisar orçamento extra
  createdAt   DateTime @default(now())

  // ---- Etapa 3 (v157) — formulário de solicitação do cliente --------------
  // origem distingue o registro rápido interno (equipe anota o que o cliente
  // pediu por fora — WhatsApp, reunião — comportamento ORIGINAL desse model,
  // preservado 100%: toda linha de antes da v157 é "interno") do pedido feito
  // pelo próprio cliente na página pública nova (/solicitar/[clienteId]).
  origem String @default("interno") // interno | cliente

  // Tipo do que está sendo pedido, no MESMO vocabulário de Tarefa.categoria
  // (gravacao|arte|reel|fotos|campanha|reuniao|contato|orcamento|ideia|outra) —
  // de propósito, pra não exigir tradução nenhuma na hora de "transformar em
  // tarefa" e porque as perguntas dinâmicas do formulário público dependem dela
  // (ver lib/solicitacoes.ts: PERGUNTAS_POR_CATEGORIA). Opcional — solicitação
  // interna antiga não tem, e o formulário público exige escolher uma.
  categoria String?

  // Respostas às perguntas dinâmicas daquela categoria, {chave: resposta}.
  // Formato: Record<string,string>. JSON pra não precisar de uma tabela nova por
  // pergunta — sempre null em solicitação interna (só o formulário público usa).
  respostas Json?

  // Prazo desejado (preenchido pelo cliente no formulário) x confirmado
  // (preenchido pela agência ao avaliar o pedido) — a Etapa 3 pede
  // explicitamente que sejam dois campos separados, nunca o mesmo campo.
  prazoDesejado   DateTime?
  prazoConfirmado DateTime?

  // Quem pediu, no formulário público — mesmo padrão dual de
  // VersaoConteudo.aprovadoPorContato/aprovadoPorNomeLivre: um Contato já
  // cadastrado OU um nome livre digitado na hora, nunca os dois, porque não
  // existe login de cliente nesse sistema (Etapa 5 é quem resolve isso de vez).
  solicitanteContatoId String?
  solicitanteContato   Contato? @relation(fields: [solicitanteContatoId], references: [id])
  solicitanteNomeLivre String?

  // Arquivos/referências enviados junto (URL do /api/upload-imagem) — mesmo
  // array simples de Tarefa.anexos, carregado pra lá ao converter em tarefa.
  anexos String[] @default([])

  // Preenchidos quando alguém "transforma em tarefa" e/ou "prepara orçamento
  // adicional" — impede converter a mesma solicitação duas vezes por engano
  // (a tela some com o botão e mostra o link pronto em vez dele).
  tarefaGeradaId       String?    @unique
  tarefaGerada         Tarefa?    @relation("SolicitacaoTarefaGerada", fields: [tarefaGeradaId], references: [id])
  orcamentoPreparadoId String?    @unique
  orcamentoPreparado   Orcamento? @relation(fields: [orcamentoPreparadoId], references: [id])
}

// Checklist reutilizável — aplica de uma vez várias tarefas num cliente/conteúdo
// (ex: "Captação": preparar pauta, conferir equipamento, captação, backup, seleção, edição)
//
// Etapa 4 (v158) — "evoluir os templates para gerar ciclos de planejamento,
// roteiro, captação, edição, aprovação, publicação e relatório" +
// "calcular prazos relativos à data de entrega ou publicação": `itens` (modo
// simples, só título, sem prazo) é MANTIDO 100% como estava — nenhum template já
// cadastrado muda de comportamento. O modo novo (`etapas`) é opt-in: quando um
// template tem pelo menos 1 `TemplateEtapa`, "aplicar" passa a pedir 1 data-alvo
// (entrega/publicação) e gera cada etapa com prazo = data-alvo + diasRelativos,
// encadeadas por DependenciaTarefa (cada uma depende da anterior). Ver
// lib/templatesTarefas.ts.
model TemplateTarefas {
  id        String   @id @default(uuid())
  nome      String
  itens     String[]
  createdAt DateTime @default(now())

  etapas          TemplateEtapa[]
  servicosLigados Servico[]
  rotinasGeradas  RotinaGerada[]
}

// Uma etapa dentro do ciclo completo de um template (Etapa 4 v158) — ver
// TemplateTarefas. `diasRelativos` é o deslocamento em DIAS a partir da data-alvo
// do ciclo (negativo = antes; ex.: planejamento -14, roteiro -10, captação -7,
// edição -4, aprovação -2, publicação 0, relatório +3 — só um ponto de partida
// sugerido, cada template define os próprios números ao ser criado/editado).
model TemplateEtapa {
  id              String          @id @default(uuid())
  templateId      String
  template        TemplateTarefas @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ordem           Int             @default(0)
  titulo          String
  categoria       String? // vocabulário de Tarefa.categoria — opcional
  diasRelativos   Int             @default(0)
  estimativaHoras Float?
  createdAt       DateTime        @default(now())
}

model Tarefa {
  id         String    @id @default(uuid())
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id])
  titulo     String
  tipo       String    @default("tarefa") // tarefa | ideia
  categoria  String? // gravacao | arte | reel | fotos | campanha | reuniao | contato | orcamento | ideia | outra
  descricao  String?
  prioridade String? @default("media") // baixa | media | alta
  status     String    @default("a_fazer") // a_fazer | em_andamento | bloqueada | feito
  prazo      DateTime?
  link       String?
  createdAt DateTime @default(now())

  // De quem é essa tarefa (redesign v144, Parte 2) — opcional, pra não quebrar
  // tarefa antiga sem dono. Preenchido só quando alguém "pega" a tarefa pra si
  // (nunca automático/adivinhado). Alimenta a fila pessoal do Início de cada
  // pessoa e o alerta de "tarefa sem responsável" no Início do dono.
  responsavelId String?
  responsavel   Usuario? @relation("TarefaResponsavel", fields: [responsavelId], references: [id])

  // Estado "Bloqueada" (Etapa 1 v152) — motivo obrigatório pra bloquear (a rota
  // recusa se vier vazio), responsável pelo desbloqueio opcional (dá pra bloquear
  // sem ainda saber quem resolve). Os 3 campos são limpos sozinhos quando a tarefa
  // sai desse status — nunca ficam "sujos" de um bloqueio antigo (ver PATCH de
  // /api/tarefas/[id]).
  motivoBloqueio        String?
  bloqueioResponsavelId String?
  bloqueioResponsavel   Usuario?  @relation("TarefaBloqueioResponsavel", fields: [bloqueioResponsavelId], references: [id])
  bloqueadaEm           DateTime?

  // Preenchido sozinho quando o status vira "feito" (e limpo se voltar pra outro
  // status) — ver PATCH de /api/tarefas/[id]. Sem isso não dava pra saber QUANDO
  // uma tarefa foi concluída, só que ela existe (createdAt é só a criação).
  concluidaEm DateTime?

  // Sub-passos de dentro da tarefa (redesign v144, Parte 2) — ex: uma tarefa de
  // "Criar Reel" pode ter "roteiro", "captação", "edição", "aprovação" como itens
  // separados. Não confundir com TemplateTarefas (que cria várias TAREFAS de uma
  // vez a partir de uma lista) — isso aqui vive dentro de UMA tarefa só.
  checklist ChecklistItemTarefa[]

  // Pasta PRÓPRIA dessa tarefa no Google Drive (dentro da pasta da semana, dentro
  // de Conteúdo do cliente), criada sob demanda quando a tarefa tem categoria de
  // mídia (gravacao/reel/fotos) + prazo + cliente com Drive conectado — ver
  // lib/google.ts: garantirPastaTarefa. Pra categoria "reel" especificamente, essa
  // pasta também é onde a gente checa se já tem vídeo bruto (arquivo de vídeo lá
  // dentro) antes de deixar a tarefa avançar de "A fazer" — ver o PATCH de
  // /api/tarefas/[id]. Até a Etapa 2 v153 essa pasta era compartilhada por TODAS as
  // tarefas do cliente na mesma semana (bug: vídeo de uma liberava as outras) —
  // corrigido pra uma pasta por tarefa; ver o comentário completo em
  // garantirPastaTarefa sobre tarefas antigas não migradas automaticamente.
  driveFolderId String?

  // Painel lateral de tarefa (Etapa 1 v152): comentários internos e histórico de
  // alterações — nunca editados/apagados depois de criados, mesmo padrão de
  // MovimentacaoVerba (extrato, não estado). Ver ComentarioTarefa/HistoricoTarefa.
  comentarios ComentarioTarefa[]
  historico   HistoricoTarefa[]

  // Horas com essa tarefa vinculada (Etapa 1 v152) — opcional, só quem nascer a
  // partir de agora vem preenchido. Ver RegistroTempo.tarefaId.
  registrosTempo RegistroTempo[]

  // Notificações internas que apontam pra essa tarefa (Etapa 1 v152).
  notificacoes Notificacao[]

  // Fluxo de revisão/aprovação de conteúdo (Etapa 2 v153) — só usado em tarefas de
  // categoria "reel" ou "arte" (ver CATEGORIAS_COM_REVISAO em
  // lib/categoriaTarefaVisual.ts). Separado do "status" genérico (a_fazer/
  // em_andamento/bloqueada/feito) de propósito: são duas dimensões diferentes (uma
  // tarefa pode estar "em_andamento" no quadro e, ao mesmo tempo, com o conteúdo em
  // "revisao_interna"). Null = tarefa fora desse fluxo, ou ainda não chegou em
  // "produção". Ao virar "publicado" pelo PATCH de /api/tarefas/[id], o status
  // geral da tarefa também vira "feito" sozinho (evita ficar marcando duas vezes).
  statusConteudo String? // producao | revisao_interna | aprovacao_cliente | agendado | publicado
  linkPublicacao String? // link do post/reel já publicado — preenchido manualmente, não existe API de publicação automática
  publicadoEm    DateTime?
  publicacaoSugeridaEm DateTime? // proposta à aprovação; não muda o prazo nem agenda automaticamente

  versoes VersaoConteudo[]
  pautasCronograma PautaCronograma[]

  // Exceção justificada pra tarefa "reel" sem vídeo bruto (Etapa 2 v153) — ex.: reel
  // feito 100% de banco de imagens/motion, sem captação própria. Só relevante pra
  // CATEGORIAS_QUE_PRECISAM_VIDEO_BRUTO; motivo obrigatório pra ligar (mesma regra
  // de motivoBloqueio acima). Os 4 campos são limpos sozinhos se a exceção for
  // desligada — nunca ficam "sujos" de uma exceção antiga.
  videoBrutoExcecao       Boolean   @default(false)
  videoBrutoExcecaoMotivo String?
  videoBrutoExcecaoPorId  String?
  videoBrutoExcecaoPor    Usuario?  @relation("TarefaVideoBrutoExcecaoPor", fields: [videoBrutoExcecaoPorId], references: [id])
  videoBrutoExcecaoEm     DateTime?

  // Anexos livres (URL) — array simples, mesmo espírito de Tarefa.link mas
  // permitindo mais de um arquivo (Etapa 3 v157: nasceu pra preservar os anexos de
  // uma Solicitação ao virar tarefa, mas fica disponível pra qualquer tarefa).
  anexos String[] @default([])

  // Preenchida sozinha quando essa tarefa nasceu de "transformar solicitação em
  // tarefa" (Etapa 3 v157) — ver Solicitacao.tarefaGeradaId. Null pra qualquer
  // tarefa criada do jeito normal (o padrão até aqui).
  solicitacaoOrigem Solicitacao? @relation("SolicitacaoTarefaGerada")

  // Etapa 4 (v158) — "adicionar estimativa de tempo às tarefas": opcional, alimenta
  // a comparação de trabalho previsto x capacidade disponível (ver lib/capacidade.ts).
  // Tarefa sem estimativa simplesmente não entra nessa soma (não conta como 0h nem
  // trava nada) — ninguém é obrigado a preencher.
  estimativaHoras Float?

  // Dependências entre tarefas (Etapa 4 v158) — "tarefaId" é ESTA tarefa quando ela
  // é quem depende de outra (precisa que a outra termine primeiro); "dependeDeId" é
  // o mesmo registro visto do lado de quem bloqueia. Duas relações nomeadas porque
  // Tarefa aponta pra Tarefa duas vezes através do mesmo model — ver
  // DependenciaTarefa e lib/dependenciasTarefa.ts (cálculo de impacto de prazo).
  dependeDe   DependenciaTarefa[] @relation("TarefaDependente")
  bloqueiaDe  DependenciaTarefa[] @relation("TarefaPrecedente")

  // Preenchida quando essa tarefa nasceu de uma rotina mensal automática (Etapa 4
  // v158, item "gerar rotinas mensais conforme os serviços contratados") — nunca
  // aparece em tarefa criada manualmente ou por "aplicar template" na mão. Só
  // informativa (mostra "gerada automaticamente" na tela); apagar a tarefa não
  // afeta a rotina em si.
  rotinaGeradaId String?
  rotinaGerada   RotinaGerada? @relation(fields: [rotinaGeradaId], references: [id])
}

// Sub-passo de dentro de uma tarefa (redesign v144, Parte 2) — ver Tarefa.checklist.
model ChecklistItemTarefa {
  id        String   @id @default(uuid())
  tarefaId  String
  tarefa    Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  titulo    String
  feito     Boolean  @default(false)
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
}

// "Criar dependências entre tarefas e mostrar impactos antes de alterar prazos"
// (Etapa 4 v158). Uma linha = "tarefa" só pode ser concluída/publicada depois que
// "dependeDe" terminar. `onDelete: Cascade` nas duas pontas — apagar qualquer uma
// das duas tarefas envolvidas não deveria deixar uma dependência solta apontando
// pro nada. Não trava nada sozinha (ver lib/dependenciasTarefa.ts): é consultada
// pra CALCULAR e MOSTRAR impacto antes de confirmar uma mudança de prazo, não pra
// impedir a mudança — a decisão final continua sendo de quem está usando o app.
model DependenciaTarefa {
  id          String   @id @default(uuid())
  tarefaId    String
  tarefa      Tarefa   @relation("TarefaDependente", fields: [tarefaId], references: [id], onDelete: Cascade)
  dependeDeId String
  dependeDe   Tarefa   @relation("TarefaPrecedente", fields: [dependeDeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([tarefaId, dependeDeId])
}

// Comentário interno numa tarefa (Etapa 1 v152) — nunca editado/apagado depois de
// criado (é o próprio histórico da conversa), mesmo padrão de MovimentacaoVerba.
// Comentário de CLIENTE vindo de relatório público é outra coisa (ver
// RelatorioPeriodo.comentarioCliente) e não vira ComentarioTarefa — a ligação dos
// dois com o painel interno é só por notificação (ver lib/notificacoes.ts).
model ComentarioTarefa {
  id       String @id @default(uuid())
  tarefaId String
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  // Opcional só pra não quebrar se a pessoa for removida da equipe depois — mesmo
  // padrão de RegistroTempo.usuarioId. Todo comentário novo vem preenchido a
  // partir da sessão de quem escreveu (nunca informado pelo corpo da requisição).
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  texto     String
  createdAt DateTime @default(now())
}

// Histórico de alterações de uma tarefa (Etapa 1 v152) — uma linha por campo
// alterado, sempre em ADIÇÃO (nunca editado/apagado), pra reconstruir "quem mudou
// o quê e quando" no painel lateral. Não registra toda alteração possível, só as
// visíveis no painel (título, descrição, responsável, prioridade, prazo, categoria,
// status/bloqueio, link) — ver PATCH de /api/tarefas/[id].
model HistoricoTarefa {
  id          String   @id @default(uuid())
  tarefaId    String
  tarefa      Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  campo       String // titulo | descricao | responsavel | prioridade | prazo | categoria | status | link
  valorAntigo String?
  valorNovo   String?
  createdAt   DateTime @default(now())
}

// Versão de material de conteúdo em revisão (Etapa 2 v153) — cada rodada de
// produção gera uma linha NOVA aqui (nunca edita uma já existente: vídeo, imagem e
// legenda ficam congelados no momento do envio), pra que os comentários de uma
// versão nunca se percam/misturem com os da versão seguinte. Escopo: só tarefas de
// categoria "reel" ou "arte" (ver CATEGORIAS_COM_REVISAO em
// lib/categoriaTarefaVisual.ts). O fluxo Produção → Revisão interna → Aprovação do
// cliente → Agendado → Publicado mora em Tarefa.statusConteudo, não aqui — esse
// model só guarda o material e a aprovação de CADA versão.
model VersaoConteudo {
  id       String @id @default(uuid())
  tarefaId String
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  numero   Int // sequencial por tarefa (1, 2, 3...) — mostrado como "Versão 2" etc.

  linkVideo  String? // link do material em revisão (Drive, WeTransfer etc.) — igual Tarefa.link, texto livre
  linkImagem String? // idem, pra arte/imagem estática
  legenda    String? // texto da legenda proposta pra essa versão

  // Preenchido a partir da sessão de quem enviou essa versão — opcional só pra não
  // quebrar se a pessoa sair da equipe depois (mesmo padrão de ComentarioTarefa.usuarioId).
  criadoPorId String?
  criadoPor   Usuario? @relation("VersaoConteudoCriadaPor", fields: [criadoPorId], references: [id])

  // Aprovação DESSA versão específica (nunca da tarefa toda) — "exigir nova
  // aprovação quando o conteúdo aprovado for alterado" fica garantido de graça: uma
  // alteração sempre nasce como versão nova, com aprovadoEm=null de novo. Como não
  // existe login de cliente no sistema, o aprovador é um Contato cadastrado OU um
  // nome livre digitado na hora (ex.: quem respondeu no WhatsApp e não está
  // cadastrado) — nunca os dois.
  aprovadoPorContatoId String?
  aprovadoPorContato   Contato?  @relation(fields: [aprovadoPorContatoId], references: [id])
  aprovadoPorNomeLivre String?
  aprovadoEm           DateTime?
  alteracoesSolicitadasEm DateTime?

  createdAt DateTime @default(now())

  comentarios ComentarioRevisao[]

  @@unique([tarefaId, numero])
}

// Comentário de revisão numa versão específica (Etapa 2 v153) — nunca
// editado/apagado depois de criado, mesmo espírito de ComentarioTarefa. Duas
// diferenças: pode vir de um Contato do cliente (ou de nome livre, pela página
// pública de revisão) e pode apontar pra um momento do vídeo ou ponto da imagem.
model ComentarioRevisao {
  id       String         @id @default(uuid())
  versaoId String
  versao   VersaoConteudo @relation(fields: [versaoId], references: [id], onDelete: Cascade)

  // Autor: equipe (usuarioId) OU contato cadastrado (contatoId) OU nome livre
  // (autorNomeLivre — comentário pela página pública sem estar cadastrado como
  // Contato). Preenchido a partir da sessão/formulário, nunca os três ao mesmo tempo.
  usuarioId      String?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  contatoId      String?
  contato        Contato? @relation(fields: [contatoId], references: [id])
  autorNomeLivre String?

  texto String

  // true = só a equipe vê (painel interno); false = compartilhado com o cliente,
  // aparece na página pública de revisão. Comentário vindo da página pública
  // (usuarioId nulo) sempre nasce com interno=false — cliente não comenta "pra si".
  interno Boolean @default(false)

  // Ponto exato do comentário — nunca os dois preenchidos ao mesmo tempo; todos
  // nulos = comentário geral da versão, sem apontar pra um instante/ponto.
  momentoVideoSegundos Int? // segundos desde o início do vídeo
  pontoImagemX         Float? // 0–100, percentual da largura
  pontoImagemY         Float? // 0–100, percentual da altura

  createdAt DateTime @default(now())
}

// Notificação interna (Etapa 1 v152) — nasce de um evento do sistema (tarefa
// atribuída, comentário novo, tarefa bloqueada, comentário de cliente no relatório
// etc.) endereçada a UM usuário. "lidaEm"/"adiadaAte" são o único estado que muda
// depois de criada — pra histórico de verdade, ver HistoricoTarefa. Repetições do
// mesmo assunto (mesma agrupadorChave) não criam linha nova enquanto a anterior não
// for lida: só sobem o "contador" e atualizam título/corpo/link/atualizadoEm (ver
// lib/notificacoes.ts) — é isso que resolve "agrupar notificações repetidas".
model Notificacao {
  id        String  @id @default(uuid())
  usuarioId String
  // Cascade de propósito: notificação é caixa de entrada (estado efêmero), não
  // histórico — se a pessoa for removida da equipe (DELETE /api/equipe/[id]), as
  // notificações dela somem junto, sem impedir a remoção (diferente de
  // HistoricoTarefa/ComentarioTarefa, que preservam autoria como "opcional").
  usuario Usuario @relation("NotificacaoDestinatario", fields: [usuarioId], references: [id], onDelete: Cascade)

  tipo   String // tarefa_atribuida | tarefa_sem_responsavel | comentario_tarefa | tarefa_bloqueada | comentario_relatorio | comentario_revisao | revisao_aprovada | solicitacao_cliente
  titulo String
  corpo  String?
  link   String? // rota interna pra abrir ao clicar, ex: "/dashboard/tarefas?tarefa=ID"

  tarefaId  String?
  tarefa    Tarefa?           @relation(fields: [tarefaId], references: [id])
  clienteId String?
  cliente   Cliente?          @relation(fields: [clienteId], references: [id])
  relatorioId String?
  relatorio   RelatorioPeriodo? @relation(fields: [relatorioId], references: [id])

  agrupadorChave String? // mesmo assunto = mesma chave — ver lib/notificacoes.ts
  contador       Int     @default(1)

  lidaEm    DateTime?
  adiadaAte DateTime? // "adiar" = some da lista até essa hora, sem marcar como lida

  criadaPorId String?
  criadaPor   Usuario? @relation("NotificacaoCriadaPor", fields: [criadaPorId], references: [id])

  createdAt    DateTime @default(now()) // quando o assunto surgiu a 1ª vez
  atualizadoEm DateTime @updatedAt // sobe a cada repetição agrupada — usado pra ordenar o sino
}

// Catálogo reutilizável de serviços — a "esteira de produto"
model Servico {
  id              String   @id @default(uuid())
  nome            String
  descricao       String // texto usado na proposta (orçamento público)
  clausulaContrato String? // texto usado no contrato — se vazio, usa a descrição
  categoria       String
  unidade         String? // ex: "mês", "reel"
  valorUnitario   Decimal

  // Etapa 3 (v157) — liga esse item do catálogo comercial ao vocabulário de
  // Tarefa.categoria (gravacao|arte|reel|fotos|campanha|reuniao|contato|orcamento|
  // ideia|outra), pra dar pra contar "quantas tarefas dessa categoria nascem por
  // mês pra esse cliente" e comparar com ServicoContratado.quantidade — ver
  // lib/entregas.ts. Opcional e null por padrão de propósito: Servico.categoria já
  // existe (rótulo amplo da seção do catálogo, ex: "🎥 Produção de Conteúdo") e é
  // uma coisa totalmente diferente disso aqui — nem todo serviço do catálogo
  // corresponde a um tipo de entrega rastreável (ex: "Consultoria mensal"), então
  // não faz sentido obrigar. Editável em Catálogo de Serviços.
  categoriaTarefa String?

  // Etapa 4 (v158) — "gerar rotinas mensais conforme os serviços contratados, sem
  // duplicações": liga esse serviço a um ciclo completo (TemplateTarefas com
  // `etapas`). Quando preenchido, todo cliente que tiver esse serviço contratado
  // (ativo) ganha esse ciclo gerado automaticamente todo mês — ver
  // garantirRotinasMensaisDoMes em lib/garantirRecorrentes.ts. Opcional e null por
  // padrão: nem todo serviço é recorrente mensal (ex.: um serviço avulso de
  // "Criação de identidade visual" não devia gerar nada sozinho todo mês).
  templateRotinaId String?
  templateRotina   TemplateTarefas? @relation(fields: [templateRotinaId], references: [id])

  itens        ItemOrcamento[]
  pacoteItens  PacoteItem[]
  contratacoes ServicoContratado[]
}

// Registro de horas trabalhadas — dado 100% interno, nunca aparece pro cliente.
model RegistroTempo {
  id        String    @id @default(uuid())
  clienteId String?
  cliente   Cliente?  @relation(fields: [clienteId], references: [id])
  // Quem lançou esse registro — opcional só pra não quebrar histórico antigo (lançado
  // antes dessa coluna existir); todo registro novo criado pela rota de API já vem com
  // isso preenchido a partir da sessão de quem estava logado.
  usuarioId String?
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])
  // Tarefa de onde esse tempo veio (Etapa 1 v152) — opcional, só quem nasce do
  // "Iniciar" do quadro pessoal ou da conclusão de uma tarefa vem preenchido; o
  // cronômetro genérico da barra do topo continua sem tarefa (isso não muda). É
  // isso que permite FECHAR o registro certo em vez de criar um novo quando a
  // tarefa é concluída — ver PATCH de /api/tarefas/[id].
  tarefaId  String?
  tarefa    Tarefa?   @relation(fields: [tarefaId], references: [id])
  atividade String // ex: "Captação", "Edição", "Reunião"
  inicio    DateTime
  fim       DateTime?
  createdAt DateTime  @default(now())
}

// Serviços que o cliente contratou de fato — o que compõe a mensalidade dele.
// O valor aqui é o valor combinado (pode ter desconto em relação ao catálogo).
model ServicoContratado {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  servicoId  String
  servico    Servico  @relation(fields: [servicoId], references: [id])
  quantidade Int      @default(1)
  valor      Decimal
  // "Remover" continua chamado assim na tela, mas por dentro (Etapa 3 v157) virou
  // desativar (ver PATCH/DELETE de /api/servicos-contratados/[id]) em vez de
  // apagar a linha — é isso que permite manter o histórico de quando o pacote
  // contratado mudou mesmo depois de um item ser removido. Nunca ficou false por
  // nenhum caminho da interface antes da v157 (só chegava a existir = true), então
  // todo cliente com pelo menos 1 serviço contratado continua exatamente igual;
  // toda leitura no app já filtra ativo:true (auditado na v157: Início, ficha do
  // cliente, resumo de cobrança, geração de contrato, orçamento novo).
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Etapa 3 (v157) — "definir se pendências acumulam pro próximo mês". Default
  // false (não acumula) de propósito: é o comportamento mais previsível pra quem
  // nunca configurou nada, e fica só a um clique de ligar por contrato quando fizer
  // sentido (ex: um pacote de artes que a Instaby deixa "rolar" de um mês pro
  // outro). Ver lib/entregas.ts.
  rolloverPendencias Boolean @default(false)

  // Histórico de alterações de quantidade/valor/ativo (Etapa 3 v157) — nunca
  // editado/apagado depois de criado, mesmo padrão de HistoricoTarefa. Ver
  // PATCH/DELETE de /api/servicos-contratados/[id].
  historico HistoricoServicoContratado[]

  // Rotinas mensais já geradas a partir deste serviço contratado (Etapa 4 v158) —
  // ver RotinaGerada.
  rotinasGeradas RotinaGerada[]
}

model HistoricoServicoContratado {
  id                  String            @id @default(uuid())
  servicoContratadoId String
  servicoContratado   ServicoContratado @relation(fields: [servicoContratadoId], references: [id], onDelete: Cascade)
  usuarioId           String?
  usuario             Usuario?          @relation(fields: [usuarioId], references: [id])
  campo               String // quantidade | valor | ativo
  valorAntigo         String?
  valorNovo           String?
  createdAt           DateTime          @default(now())
}

// Controle de deduplicação da geração automática mensal de rotinas (Etapa 4 v158,
// item "sem duplicações") — mesmo espírito de LoteImportacao/HistoricoTarefa: um
// registro por (serviço contratado, mês, ano), nunca reaproveitado nem sobrescrito.
// `tarefas` (relação inversa de Tarefa.rotinaGeradaId) mostra quais tarefas
// nasceram daquele disparo; apagar uma delas não desfaz o registro nem libera
// gerar de novo no mesmo mês — ver garantirRotinasMensaisDoMes em
// lib/garantirRecorrentes.ts.
model RotinaGerada {
  id                  String            @id @default(uuid())
  clienteId           String
  cliente             Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servicoContratadoId String
  servicoContratado   ServicoContratado @relation(fields: [servicoContratadoId], references: [id], onDelete: Cascade)
  templateId          String
  template            TemplateTarefas   @relation(fields: [templateId], references: [id])
  mes                 Int // 0-11
  ano                 Int
  createdAt           DateTime          @default(now())

  tarefas Tarefa[]

  @@unique([servicoContratadoId, mes, ano])
}

model Pacote {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  createdAt DateTime @default(now())

  itens PacoteItem[]
}

model PacoteItem {
  id         String @id @default(uuid())
  pacoteId   String
  pacote     Pacote  @relation(fields: [pacoteId], references: [id])
  servicoId  String
  servico    Servico @relation(fields: [servicoId], references: [id])
  quantidade Int     @default(1)
}

model Orcamento {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  slug      String   @unique
  status    String   @default("pendente") // pendente | aceito | recusado
  enviadoEm DateTime?
  visualizadoEm DateTime?
  dataAceite DateTime? // congela o momento exato do aceite — a proposta não muda mais depois disso
  apresentacao Json? // textos e tipo de exibição próprios desta proposta
  createdAt DateTime @default(now())

  itens     ItemOrcamento[]
  contratos Contrato[]
  cobrancas Cobranca[]

  // Preenchida sozinha quando esse orçamento nasceu do botão "Preparar orçamento"
  // de uma Solicitação fora do escopo (Etapa 3 v157) — ver
  // Solicitacao.orcamentoPreparadoId. Null pra qualquer orçamento feito do jeito
  // normal (o padrão até aqui). Não muda em nada o ciclo pendente→aceito
  // existente — continua sem cobrar automaticamente, só nasce com esse vínculo.
  solicitacaoOrigem Solicitacao?
}

model ItemOrcamento {
  id          String    @id @default(uuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])
  servicoId   String
  servico     Servico   @relation(fields: [servicoId], references: [id])
  quantidade  Int       @default(1)
  valor       Decimal
  // Congelados no momento em que o item foi adicionado ao orçamento — se o nome/descrição
  // do serviço mudar depois no catálogo, essa proposta específica continua mostrando o que
  // foi combinado na hora. Nulo = orçamento antigo, de antes dessa mudança (usa o live join).
  nomeServico      String?
  descricaoServico String?
}

model Contrato {
  id          String     @id @default(uuid())
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id])
  orcamentoId String?
  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id])
  conteudo    String
  status      String     @default("rascunho") // rascunho | enviado | assinado
  arquivoUrl  String? // link do PDF assinado anexado (upload manual ou link externo — Drive etc.)
  createdAt   DateTime   @default(now())
}

model Cobranca {
  id          String     @id @default(uuid())
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id])
  orcamentoId String?
  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id])
  valor       Decimal
  tipo        String     @default("recorrente") // recorrente | unica
  categoria   String? // ex: "Serviços", "Mensalidades", "Produtos" — texto livre
  dataCompetencia DateTime? // mês a que a receita pertence — se vazio, usa createdAt
  dataRecebimento DateTime? // quando o dinheiro realmente entrou
  vencimento  DateTime?
  status      String     @default("pendente") // pendente | pago | atrasado | cancelado
  createdAt   DateTime   @default(now())
  recorrenciaChave String? @unique // cliente:AAAA-MM, apenas mensalidades automáticas
  pagamentos  Pagamento[]
}

model Despesa {
  id                 String   @id @default(uuid())
  clienteId          String?
  cliente            Cliente? @relation(fields: [clienteId], references: [id])
  descricao          String
  valor              Decimal
  tipo               String   @default("flexivel") // fixa | flexivel — mantido pro gráfico existente
  categoriaFinanceira String? // custo | despesa_fixa | despesa_variavel | despesa_financeira | imposto | investimento | transferencia
  categoria          String? // ex: "Aluguel", "Material de escritório" — texto livre
  subcategoria       String?
  status             String   @default("pago") // pendente | pago | atrasado | cancelado
  vencimento         DateTime? // só relevante quando status = pendente/atrasado
  dataPagamento      DateTime? // quando o dinheiro realmente saiu (pode ser diferente da competência)
  recorrente         Boolean  @default(false) // true só na despesa "modelo" — repete todo mês sozinha
  origemRecorrenteId String? // preenchido nas cópias geradas automaticamente todo mês
  data               DateTime @default(now()) // data de competência — mês a que o gasto pertence
  pagamentos         Pagamento[]
  patrimonio         Patrimonio[]
}

// Bens/ativos da empresa — equipamentos, móveis etc. Nasce (opcionalmente) quando
// uma despesa é lançada como "Investimento / Ativo" e você confirma que quer
// registrar no patrimônio. Não entra na DRE (isso já era assim); esse model só
// dá um lugar pra acompanhar o que a empresa tem, valor e estado de uso.
model Patrimonio {
  id              String    @id @default(uuid())
  nome            String
  categoria       String? // Equipamento audiovisual | Computador | Móveis | Outros
  valorAquisicao  Decimal
  valorAtual      Decimal // editável — você atualiza conforme deprecia/revende
  data            DateTime  @default(now())
  status          String    @default("em_uso") // em_uso | vendido | baixado
  despesaOrigemId String?
  despesaOrigem   Despesa?  @relation(fields: [despesaOrigemId], references: [id])
  createdAt       DateTime  @default(now())
}

// Tráfego pago — gestão da campanha (verba, plataforma, período). A verba de mídia
// (ver VerbaTrafego) não passa pela agência (vai direto do cliente pra plataforma),
// então não tem ligação com Financeiro — só os honorários da agência (mensalidade,
// em ServicoContratado/Cobranca) é que passam por ali, e o módulo de tráfego nunca
// lê nem mostra nada de lá (gerenciarTrafego não abre Financeiro).
model Campanha {
  id           String    @id @default(uuid())
  clienteId    String
  cliente      Cliente   @relation(fields: [clienteId], references: [id])
  nome         String
  plataforma   String // meta_ads | google_ads | tiktok_ads | outro
  objetivo     String? // conversao | alcance | trafego | engajamento | leads | vendas | outro
  verbaMensal  Decimal   @default(0)
  // Legado (era o único status, "ativa"/"pausada"/"encerrada") — a partir da v151
  // é mantido em espelho de statusInterno (ver mapStatusInternoParaLegado em
  // lib/trafego.ts), só pra não quebrar quem já lia esse campo: o Início do
  // gestor de tráfego (app/dashboard/page.tsx, 3 queries com status:"ativa") e
  // o alerta de criativos pendentes. Toda tela nova do módulo lê/escreve
  // statusInterno; esse campo aqui nunca é editado direto por elas.
  status       String    @default("ativa") // ativa | pausada | encerrada
  dataInicio   DateTime  @default(now())
  dataFim      DateTime?
  observacoes  String?
  createdAt    DateTime  @default(now())

  // Identidade externa pra importação do Meta (v151). idExternoMeta só vem
  // preenchido se a exportação do Meta incluir uma coluna de ID (hoje não inclui —
  // ver ImportarCampanhasMeta). Sem ID, a conciliação usa chaveCorrespondencia
  // (nome + configuração de atribuição normalizados) e, quando isso também for
  // ambíguo (ex: nome duplicado com a mesma atribuição), cai pra conferência
  // manual — nunca uni campanhas só pelo nome. nomesOriginaisMeta guarda todo
  // nome bruto já vinculado aqui manualmente, pra a próxima importação reconhecer
  // de novo sem perguntar (ver lib/importacaoMeta.ts).
  idExternoMeta        String?   @unique
  chaveCorrespondencia String?
  nomesOriginaisMeta   String[]  @default([])

  // Status interno (v151) — controle SEU, "em acompanhamento/pausada/finalizada/
  // arquivada", completamente separado do que o Meta reporta (ultimoStatusMeta,
  // abaixo). Finalizar ou arquivar aqui NUNCA desliga a campanha na Meta de
  // verdade nem some com o gasto histórico dela — é só organização (ver
  // lib/trafego.ts: gastoAcumuladoCampanha soma independente de statusInterno).
  statusInterno String @default("em_acompanhamento") // em_acompanhamento | pausada | finalizada | arquivada

  // Último status de veiculação reportado pelo Meta na importação mais recente —
  // puramente informativo (mostrado ao lado do statusInterno na tela), nunca usado
  // pra decidir nada sozinho.
  ultimoStatusMeta   String?
  ultimoStatusMetaEm DateTime?

  // Orçamento do conjunto de anúncios da campanha (não é a verba/saldo do cliente
  // nem a verbaMensal acima) — só informativo, vindo da última importação.
  orcamentoConjunto Decimal?
  tipoOrcamento     String? // ex: "Diário", "Usando o orçamento do conjunto de anúncios"

  // Avaliação (v151) — separada do statusInterno de propósito: uma campanha pode
  // estar "finalizada" e nunca ter sido avaliada, ou "em acompanhamento" e já
  // estar "abaixo da meta". Uma campanha inativa não significa que fracassou.
  avaliacao            String    @default("nao_avaliada") // nao_avaliada | dentro_da_meta | abaixo_da_meta | inconclusiva
  avaliacaoObjetivo    String?
  avaliacaoMeta        String?
  avaliacaoObservacoes String?
  avaliadoPorId        String?
  avaliadoPor          Usuario?  @relation(fields: [avaliadoPorId], references: [id])
  avaliadoEm           DateTime?

  resultados      ResultadoCampanha[]
  itensImportacao ItemImportacao[]
}

// Resultado de campanha — lançado manualmente pelo gestor de tráfego (fase 3 do módulo)
// OU importado automaticamente do export CSV/Excel do Gerenciador de Anúncios do Meta
// (v119). O par (campanhaId, inicio, fim) é único: reimportar o mesmo período atualiza
// em vez de duplicar — por isso é importante exportar do Meta com o detalhamento "Dia"
// (cada linha vira inicio=fim=aquele dia), senão períodos com datas sobrepostas (ex: o
// "últimos 30 dias" padrão do Meta, exportado de novo alguns dias depois) não deduplicam
// entre si — só a reexportação exata do mesmo período é substituída.
model ResultadoCampanha {
  id                String    @id @default(uuid())
  campanhaId        String
  campanha          Campanha  @relation(fields: [campanhaId], references: [id])
  inicio            DateTime
  fim               DateTime
  verbaInvestida    Decimal?
  impressoes        Int?
  alcance           Int?
  cliques           Int?
  resultados        Int? // leads/vendas/conversões — o que contar depende do objetivo da campanha
  indicadorResultado String? // texto do Meta explicando o que "resultados" significa aqui (ex: "Conversas por mensagem iniciadas")
  origem            String    @default("manual") // manual | meta_import
  observacoes       String?
  // Fechamento do mês — preenchido à parte (geralmente na última exportação do período):
  // quantos leads desse período viraram contrato de fato, e quanto isso gerou de receita.
  // Mostra o "investimento x retorno" do tráfego pago, não só custo/resultado bruto.
  planosFechados    Int?
  valorRetorno      Decimal?
  createdAt         DateTime  @default(now())

  @@unique([campanhaId, inicio, fim])
}

// Verba de mídia por cliente (v151) — controle INTERNO da agência, não uma consulta
// ao saldo da Meta. O saldo continua entre meses, sem precisar transportá-lo de novo.
// Saldo inicial é o ponto de partida; nada aqui reseta sozinho na virada do mês.
// Saldo restante nunca é guardado direto: é sempre CALCULADO como
// saldoInicial + soma(movimentacoes.valor) − gastoAcumuladoCliente(clienteId)
// (ver lib/trafego.ts), onde gastoAcumuladoCliente soma o gasto de TODAS as
// campanhas do cliente, inclusive finalizadas/arquivadas — arquivar não tira nada
// dessa conta.
model VerbaTrafego {
  id           String   @id @default(uuid())
  clienteId    String   @unique
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  saldoInicial Decimal  @default(0)
  inicioControle DateTime?
  observacoes  String?
  atualizadoEm DateTime @updatedAt
  createdAt    DateTime @default(now())

  movimentacoes MovimentacaoVerba[]
}

// Histórico de aportes/devoluções/ajustes/saldo transportado de um cliente — nunca
// editado nem apagado depois de criado (é o próprio extrato). "tipo" separa o aporte
// de mídia normal de uma correção pontual (devolução do Meta, ajuste de divergência)
// e do registro explícito de virada de mês. "valor" é sempre a MAGNITUDE (positivo);
// quem decide se soma ou subtrai do saldo é o "tipo" (ver calcularSaldoCliente em
// lib/trafego.ts) — aporte/saldo_transportado somam, devolução/ajuste subtraem.
model MovimentacaoVerba {
  id            String       @id @default(uuid())
  verbaId       String
  verba         VerbaTrafego @relation(fields: [verbaId], references: [id])
  tipo          String // aporte | devolucao | ajuste | saldo_transportado
  valor         Decimal // sempre positivo — a magnitude do lançamento
  descricao     String?
  dataMovimento DateTime @default(now())
  criadoPorId   String?
  criadoPor     Usuario? @relation(fields: [criadoPorId], references: [id])
  createdAt     DateTime @default(now())
}

// Um lote = um arquivo CSV do Meta já CONFIRMADO pelo usuário — nada é gravado
// enquanto só está em prévia (ver app/api/campanhas/importar-meta/preview, que não
// grava nada, e .../confirmar, que grava tudo isto de uma vez, dentro de uma
// transação). arquivoUrl preserva o arquivo original de verdade, subido pro Vercel
// Blob (mesmo padrão já usado em upload-contrato/upload-logo/upload-imagem) — assim
// dá sempre pra abrir de novo o CSV exato que gerou cada lote.
model LoteImportacao {
  id                String   @id @default(uuid())
  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id])
  contaAnuncios     String? // nome da conta de anúncios, só quando identificável no arquivo
  nomeArquivo       String
  arquivoUrl        String // URL do arquivo original no Vercel Blob
  periodoInicio     DateTime
  periodoFim        DateTime
  // true = o período desse arquivo é mais antigo que a última importação já
  // confirmada desse cliente — nesse caso nada foi aplicado automaticamente
  // (ver lib/importacaoMeta.ts); só chega a existir gravado se o usuário confirmou
  // essa aplicação explicitamente na prévia.
  arquivoAntigo     Boolean  @default(false)
  linhasTotal       Int
  linhasComGasto    Int
  gastoTotalArquivo Decimal
  criadoPorId       String?
  criadoPor         Usuario? @relation(fields: [criadoPorId], references: [id])
  createdAt         DateTime @default(now())

  itens ItemImportacao[]
}

// Uma linha do arquivo já resolvida (vinculada a uma Campanha existente ou marcada
// como nova) com o cálculo do incremento preservado. É esse histórico — não um
// contador solto — que garante reimportação segura: o "gasto anterior" de uma
// importação nova é sempre lido daqui (do lote confirmado anterior no mesmo mês),
// nunca de um campo único que alguém poderia sobrescrever.
model ItemImportacao {
  id         String          @id @default(uuid())
  loteId     String
  lote       LoteImportacao  @relation(fields: [loteId], references: [id], onDelete: Cascade)
  campanhaId String?
  campanha   Campanha?       @relation(fields: [campanhaId], references: [id])

  nomeOriginal       String
  idExternoOriginal  String?
  statusMetaOriginal String?
  configAtribuicao   String?

  gastoAcumuladoArquivo Decimal // valor bruto do arquivo pra essa campanha (acumulado desde o dia 1 do mês, segundo o Meta)
  gastoAnterior         Decimal // o que o sistema já sabia antes desse import (0 se é a 1ª aparição no mês)
  gastoIncremental      Decimal // gastoAcumuladoArquivo − gastoAnterior — pode ser negativo numa correção pra baixo

  impressoes         Int?
  alcance            Int?
  resultados         Int?
  indicadorResultado String?
  custoPorResultado  Decimal?
  orcamentoConjunto  Decimal?
  tipoOrcamento      String?
  termino            DateTime?

  resolucao String // auto_id | auto_chave | manual | nova_campanha
  createdAt DateTime @default(now())
}

// Versão congelada de um relatório gerado pro cliente — o "Baixar PDF" imprime
// sempre uma dessas linhas, nunca um recálculo ao vivo, porque preservar versão
// significa continuar mostrando amanhã exatamente o que foi gerado hoje. Cada
// clique em "Gerar relatório" cria uma linha nova (nunca sobrescreve).
model RelatorioTrafego {
  id                   String   @id @default(uuid())
  clienteId            String
  cliente              Cliente  @relation(fields: [clienteId], references: [id])
  periodoInicio        DateTime
  periodoFim           DateTime
  parcial              Boolean  @default(false) // true quando os dados disponíveis não cobrem o período inteiro pedido
  campanhaIds          String[] // selecionar campanhas pro relatório não mexe no saldo do cliente
  dadosSnapshot        Json // resumo, por-campanha, indicadores e pontos de gráfico já calculados no momento da geração
  avaliacaoGeral       String?
  observacoes          String?
  proximosPassos       String?
  dataAtualizacaoDados DateTime // data do lote mais recente considerado nesse snapshot
  versao               Int // sequencial por cliente (1, 2, 3...)
  geradoPorId          String?
  geradoPor            Usuario? @relation(fields: [geradoPorId], references: [id])
  createdAt            DateTime @default(now())

  @@unique([clienteId, versao])
}

// Depoimentos fixos — aparecem em toda página de orçamento
model Depoimento {
  id          String  @id @default(uuid())
  nomeCliente String
  texto       String
  ativo       Boolean @default(true)
}

// Configurações gerais da agência — sempre 1 registro só (id fixo "config")
model Configuracao {
  id                    String   @id @default("config")
  whatsappAgencia       String? // formato: 5519999999999 (DDI+DDD+número, só dígitos)
  metaFaturamentoMensal Decimal?
  custoHoraPadrao       Decimal? // usado pra calcular rentabilidade descontando o custo das horas trabalhadas
  templateOnboarding    String[] @default([]) // itens do checklist padrão — se vazio, usa o do documento original
  // Conteúdo editável do site público (/) — se vazio, a página usa o texto padrão embutido no código.
  siteHeroTitulo        String?
  siteHeroSubtitulo     String?
  siteHeroImagemUrl     String?
  siteHeroImagemUrlMobile String? // opcional — se vazio, usa a imagem principal (recortada) também no celular
  siteHeroFoco          String? // ponto de enquadramento da imagem, ex: "75% 50%" (objectPosition CSS) — padrão "50% 50%"
  siteHeroTituloDestaque String? // trecho do siteHeroTitulo que fica dourado, ex: "resultado"
  siteHeroIndicadores   Json? // até 3 indicadores do Hero: [{"valor":"+50","legenda":"projetos entregues"}] — vazio/null = linha oculta
  siteServicos          Json? // override dos 8 cartões de Serviços: [{"nome":..,"descricao":..,"destino":..}] — índice ausente/vazio usa o padrão embutido
  siteDiferenciais      Json? // override dos 4 itens da faixa de Diferenciais: [{"titulo":..,"texto":..}] — mesma lógica
  siteSobreTexto        String?
  siteSobreImagemUrl    String?
  siteSobreImagemUrlMobile String? // opcional — mesma lógica do Hero
  siteSobreFoco         String? // ponto de enquadramento, ex: "50% 30%"
  siteSobreBotaoTexto   String? // ex: "Conheça nossa história"
  siteSobreBotaoUrl     String?
  // Card vermelho vibrante logo após "Quem somos" (prova social/confiança) — título
  // curto e uma linha de apoio opcional. Vazio = usa o texto padrão embutido.
  siteProvaSocialTitulo String?
  siteProvaSocialTexto  String?
  siteProcessoTexto     String?
  siteProcessoBotaoTexto String?
  siteProcessoBotaoUrl  String?
  siteProcessoImagemUrl String? // foto de fundo opcional da faixa "Processo" — some atrás do gradiente vermelho, não substitui ele
  siteProcessoImagemUrlMobile String? // opcional — mesma lógica do Hero/Sobre
  siteProcessoFoco      String? // ponto de enquadramento, ex: "50% 30%"
  // Override opcional das 4 etapas do Processo (carrossel) — o número do passo
  // (01-04) continua fixo no código, só título/texto/foto por etapa são editáveis:
  // [{"titulo":..,"texto":..,"imagemUrl":..,"foco":..}]. Índice ausente/vazio usa
  // o padrão embutido (sem foto).
  siteProcessoEtapas    Json?
  siteCtaTitulo         String?
  siteCtaTexto          String?
  siteCtaBotaoTexto     String?
  siteCtaImagemUrl      String?
  siteCtaImagemUrlMobile String?
  siteCtaFoco           String?
  siteRodapeRegiao      String? // ex: "Araras · Campinas · São Paulo"
  siteRodapeDireitos    String? // ex: "© 2026 Instaby Agência. Todos os direitos reservados."
  siteRodapeTexto       String? // frase institucional do rodapé
  siteCorTitulo         String? // hex, ex: "#FFFFFF" — cor dos títulos sobre os banners (Hero/Sobre/Contato final)
  siteCorTexto          String? // hex, ex: "#FFFFFF" — cor dos parágrafos/legendas sobre os banners
  // Abertura cinematográfica (câmera) que roda antes do Hero, na home pública.
  siteAberturaTitulo    String? // linha de impacto que aparece durante a animação de abertura
  siteAberturaSubtitulo String? // linha de apoio, menor, embaixo do título da abertura
  // Os 3 pilares em destaque logo após o Hero: [{"nome":..,"texto":..,"indicadores":[{"valor":..,"legenda":..}]}]
  // Índice 0 = Tráfego Pago (carro-chefe, bloco maior — só ele usa "indicadores"), 1 = Criação de Conteúdo,
  // 2 = Captação. Índice ausente/vazio usa o padrão embutido no código.
  sitePilares           Json?
  siteAlbunsTitulo      String? // título da seção de álbuns/portfólio (carrossel)
  siteAlbunsTexto       String? // texto de apoio da seção de álbuns
  // Fotos extras que entram num rodízio (crossfade) com siteHeroImagemUrl no banner do Hero.
  // [{"url":..,"foco":".."}] — vazio/1 imagem só = Hero estático, do jeito que sempre foi.
  siteHeroGaleria       Json?
  // Seção "onde a gente atende": [{"nome":"Araras, SP"}, ...] — o primeiro item é sempre a
  // sede (nó principal, em destaque no mapa), os demais são clientes/atendimentos (nós
  // menores, conectados por linha). Posição de cada nó no mapa é calculada no componente
  // (não guardamos coordenada) — só a ordem da lista importa.
  siteMapaTitulo        String?
  siteMapaTexto         String?
  siteMapaLocais        Json?
  // Conteúdo editável da página de links (/link)
  linkBioIntroTexto     String?
  linkBioRodapeTexto    String?
  linkBioImagemUrl      String? // foto de topo (estilo capa), atrás do nome da agência
  linkBioTagline        String? // frase pequena estilo "escrita à mão", ex: "Mais que uma agência."
  linkBioTags           String? // linha pequena em caixa alta, ex: "MARCA · CONTEÚDO · TRÁFEGO · RESULTADO"
  linkBioInstagram      String? // links das redes pro carrossel de ícones no fim da página
  linkBioYoutube        String?
  linkBioTiktok         String?
  linkBioLinkedin       String?
  // Texto livre com instruções de pagamento (ex: chave PIX, dados bancários) — aparece
  // no resumo de cobrança em PDF que você manda pro cliente. Vazio = seção não aparece.
  instrucoesCobranca    String?

  // Conexão com o Google Drive da agência (uma só, pra conta toda — não é por membro
  // da equipe). googleDriveRefreshToken nunca é devolvido pro navegador em nenhuma
  // rota; só usado no servidor pra gerar um token de acesso novo a cada chamada à API
  // do Drive. googleDriveEmail é só pra mostrar "Conectado como fulano@..." na tela.
  googleDriveRefreshToken String?
  googleDriveEmail        String?
  googleDriveConectadoEm  DateTime?
}

// Trabalhos do portfólio, mostrados na Landing Page pública (seção Portfólio).
// "destaque" controla se o card aparece grande (linha inteira) ou no grid normal.
model CaseTrabalho {
  id        String   @id @default(uuid())
  nome      String
  categoria String? // ex: "SOCIAL MEDIA / TRÁFEGO / PRODUÇÃO"
  imagemUrl String?
  imagemFoco String? // ponto de enquadramento da capa, ex: "50% 30%"
  descricao String? // texto curto — usado no card e no destaque principal
  descricaoCompleta String? // texto longo — usado na página de case (/portfolio/[id]) quando não há link externo
  botaoTexto String? // ex: "Ver case completo" — se vazio, usa esse padrão
  resultados Json? // indicadores opcionais do destaque: [{"valor":"+478","legenda":"cliques em 15 dias"}]
  link      String? // opcional — se preenchido, o botão do case leva pra esse link externo em vez da página /portfolio/[id]
  destaque  Boolean  @default(false)
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Itens da página de links (/link, estilo Linktree) — editável pelo próprio Duhzao,
// sem precisar mexer em código.
model LinkBio {
  id        String   @id @default(uuid())
  titulo    String
  descricao String? // subtítulo curto embaixo do título, ex: "Atendimento rápido"
  url       String
  imagemUrl String? // capa opcional, recomendado 200x200px (ou 600x400px se "destaque")
  destaque  Boolean  @default(false) // true = aparece como card grande com foto, no fim da lista
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Vendas informadas pelo gestor, independentes das importações e preservadas
// por cliente/mês. apuradoAte evita usar vendas do fechamento em uma prévia antiga.
model RetornoMensalTrafego {
  id           String   @id @default(uuid())
  clienteId    String
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  mes          String
  apuradoAte   DateTime
  itens        Json
  observacoes  String?
  atualizadoPorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([clienteId, mes])
}

// Proposta compartilhada: snapshots explícitos, independentes da produção e
// da aprovação de conteúdo final. Comentários não mudam estados de tarefa.
model CronogramaCliente {
  id        String @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mes       String
  token     String @unique
  ativo     Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pautas    PautaCronograma[]

  @@unique([clienteId, mes])
}

model PautaCronograma {
  id           String @id @default(uuid())
  cronogramaId String
  cronograma   CronogramaCliente @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)
  tarefaId     String?
  tarefa       Tarefa? @relation(fields: [tarefaId], references: [id], onDelete: SetNull)
  titulo       String
  formato      String
  dataPrevista String // AAAA-MM-DD; data proposta, sem horário
  textoCliente String // somente texto revisado explicitamente para compartilhar
  visivel      Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comentarios  ComentarioPauta[]

  @@unique([cronogramaId, tarefaId])
  @@index([cronogramaId, visivel])
}

model ComentarioPauta {
  id        String @id @default(uuid())
  pautaId   String
  pauta     PautaCronograma @relation(fields: [pautaId], references: [id], onDelete: Cascade)
  autor     String
  texto     String
  origem    String // cliente | agencia; nome informado não comprova identidade
  createdAt DateTime @default(now())

  @@index([pautaId, createdAt])
}
