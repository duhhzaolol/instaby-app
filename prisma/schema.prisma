generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Login único (você) — mesmo padrão do JM Team
model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  senha     String
  nome      String
  createdAt DateTime @default(now())
}

model Cliente {
  id                 String    @id @default(uuid())
  nome               String
  whatsapp           String?
  cnpj               String?
  contatoNome        String?
  endereco           String?
  logoUrl            String?
  linkDrive          String?
  cor                String? // hex — usada como accent do cliente (badges, tarefas, agenda)
  status             String    @default("lead") // lead | ativo | inativo
  descontoMensal     Decimal   @default(0) // abatido do total dos serviços contratados
  acrescimoMensal    Decimal   @default(0) // somado ao total — pra cobrir serviços já combinados mas ainda não cadastrados
  prazoContratoMeses Int?
  valorRenovacao     Decimal?
  exibirLogoPublico  Boolean   @default(false) // aparece na vitrine "empresas que confiam" das propostas
  createdAt          DateTime  @default(now())

  tarefas             Tarefa[]
  orcamentos          Orcamento[]
  contratos           Contrato[]
  cobrancas           Cobranca[]
  despesas            Despesa[]
  servicosContratados ServicoContratado[]
  registrosTempo      RegistroTempo[]
  redesGerenciadas    String[] @default([]) // instagram | tiktok | facebook | google | meta_ads
  relatorios          RelatorioPeriodo[]
  conteudos           Conteudo[]
  contatos            Contato[]
  links               LinkCliente[]
  onboarding          Onboarding?
  solicitacoes        Solicitacao[]
}

// Relatório de performance por rede e por período — dado lançado manualmente (Fase 1).
model RelatorioPeriodo {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  rede        String // instagram | tiktok | facebook | google | meta_ads
  inicio      DateTime
  fim         DateTime

  seguidoresInicio     Int?
  seguidoresFim        Int?
  alcance              Int?
  impressoes           Int?
  curtidas             Int?
  comentariosQtd       Int?
  compartilhamentos    Int?
  salvamentos          Int?
  visualizacoes        Int?
  postsPublicados      Int?
  reelsPublicados      Int?

  investimento Decimal?
  cliques      Int?
  leads        Int?

  comentarioAgencia String?
  comentarioCliente String?

  createdAt DateTime @default(now())
}

// Contatos adicionais do cliente — o campo antigo Cliente.contatoNome continua existindo
// e funcionando (é o "contato principal" implícito de quem tinha só um), isso aqui é aditivo.
model Contato {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])

  nome         String
  cargo        String?
  telefone     String?
  whatsapp     String?
  email        String?
  observacoes  String?

  principal          Boolean @default(false)
  financeiro         Boolean @default(false)
  aprovacaoConteudo  Boolean @default(false)
  contratos          Boolean @default(false)

  createdAt DateTime @default(now())
}

// Links e referências do cliente (Drive, Canva, redes sociais, etc) — Cliente.linkDrive
// continua existindo e funcionando, isso aqui é uma lista adicional mais completa.
model LinkCliente {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  tipo      String // drive | canva | site | instagram | tiktok | meta_business | google_ads | linktree | brandbook | fotos | videos | outro
  label     String?
  url       String
  createdAt DateTime @default(now())
}

// Onboarding — checklist do começo de um cliente novo, até ficar operacional de verdade.
// Tempo lançado em cada item vira um RegistroTempo de verdade (módulo Horas já existente),
// sem duplicar dado — ver ItemOnboarding.registroTempoId.
model Onboarding {
  id          String   @id @default(uuid())
  clienteId   String   @unique
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  dataInicio  DateTime @default(now())
  status      String   @default("em_andamento") // em_andamento | concluido
  itens       ItemOnboarding[]
  createdAt   DateTime @default(now())
}

model ItemOnboarding {
  id             String     @id @default(uuid())
  onboardingId   String
  onboarding     Onboarding @relation(fields: [onboardingId], references: [id])
  titulo         String
  responsavel    String     @default("agencia") // agencia | cliente | terceiro
  status         String     @default("pendente") // pendente | concluido | bloqueado
  observacao     String?
  registroTempoId String? // aponta pro RegistroTempo criado quando lança tempo nesse item
  dataConclusao  DateTime?
  ordem          Int        @default(0)
  createdAt      DateTime   @default(now())
}

// Baixa/pagamento parcial de uma cobrança ou despesa — permite quitar aos poucos.
// O status "atrasado" não é mais escolhido manualmente daqui pra frente: é calculado
// (vencimento passou + ainda tem saldo em aberto) — ver lib/statusFinanceiro.ts.
model Pagamento {
  id          String    @id @default(uuid())
  cobrancaId  String?
  cobranca    Cobranca? @relation(fields: [cobrancaId], references: [id])
  despesaId   String?
  despesa     Despesa?  @relation(fields: [despesaId], references: [id])
  valor       Decimal
  data        DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

// Pipeline comercial simples — existe ANTES de virar Cliente (evita duplicar cadastro:
// ao ganhar, gera o Cliente e liga aqui via clienteId, nunca cria dois registros soltos).
model Oportunidade {
  id              String    @id @default(uuid())
  nome            String // empresa ou pessoa
  contatoNome     String?
  contatoWhatsapp String?
  origem          String? // indicação, instagram, site, evento...
  interesse       String? // o que a pessoa quer
  valorEstimado   Decimal?
  status          String    @default("novo_lead")
  // novo_lead | contato_feito | reuniao | proposta_enviada | negociacao | ganho | perdido
  proximaAcao     String?
  dataProximaAcao DateTime?
  observacoes     String?
  motivoPerda     String?
  clienteId       String? // preenchido quando ganha e vira Cliente de verdade
  createdAt       DateTime  @default(now())
}

// Pedido do cliente que chega fora do fluxo normal — "faz isso pra mim", "preciso de..."
model Solicitacao {
  id          String   @id @default(uuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  descricao   String
  prioridade  String   @default("media") // baixa | media | alta
  status      String   @default("pendente") // pendente | em_andamento | concluida
  extra       Boolean  @default(false) // true = fora do escopo contratado, pode precisar orçamento extra
  createdAt   DateTime @default(now())
}

// Checklist reutilizável — aplica de uma vez várias tarefas num cliente/conteúdo
// (ex: "Captação": preparar pauta, conferir equipamento, captação, backup, seleção, edição)
model TemplateTarefas {
  id        String   @id @default(uuid())
  nome      String
  itens     String[]
  createdAt DateTime @default(now())
}

model Tarefa {
  id         String    @id @default(uuid())
  clienteId  String?
  cliente    Cliente?  @relation(fields: [clienteId], references: [id])
  conteudoId String?
  conteudo   Conteudo? @relation(fields: [conteudoId], references: [id])
  titulo     String
  tipo       String    @default("tarefa") // tarefa | ideia
  categoria  String? // gravacao | arte | reel | fotos | campanha | reuniao | contato | orcamento | ideia | outra
  descricao  String?
  prioridade String? // baixa | media | alta
  status     String    @default("a_fazer") // a_fazer | em_andamento | feito
  prazo      DateTime?
  link       String?
  createdAt DateTime @default(now())
}

// Uma publicação/peça de conteúdo — diferente de tarefa: tem briefing, roteiro, pipeline de produção próprio.
// Uma tarefa pode se vincular a um conteúdo (ex: "gravar", "editar", "publicar"), mas conteúdo não substitui tarefa.
model Conteudo {
  id        String   @id @default(uuid())
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  titulo    String
  campanha  String?
  formato   String? // reel | story | carrossel | post | foto | video | ads | outro
  objetivo  String?
  pilar     String?
  redes     String[] @default([]) // instagram | tiktok | facebook | google | meta_ads
  tipoVeiculacao String @default("organico") // organico | anuncio

  briefing    String?
  roteiro     String?
  legenda     String?
  cta         String?
  referencias String?
  linkArquivos String?

  dataCaptacao    DateTime?
  prazoEdicao     DateTime?
  prazoAprovacao  DateTime?
  dataPublicacao  DateTime?
  urlPublicada    String?

  status String @default("ideia")
  // ideia | planejado | producao | edicao | revisao_interna | aguardando_aprovacao | alteracao_solicitada | aprovado | agendado | publicado

  tokenAprovacao        String?   @unique // gerado ao enviar pra aprovação, vira o link público
  enviadoAprovacaoEm    DateTime?
  visualizadoAprovacaoEm DateTime?
  aprovadoEm            DateTime?
  aprovadoPor           String?
  comentarioAprovacao   String? // feedback do cliente ao pedir alteração

  tarefas   Tarefa[]
  createdAt DateTime @default(now())
}

// Catálogo reutilizável de serviços — a "esteira de produto"
model Servico {
  id              String   @id @default(uuid())
  nome            String
  descricao       String // texto usado na proposta (orçamento público)
  clausulaContrato String? // texto usado no contrato — se vazio, usa a descrição
  categoria       String
  unidade         String? // ex: "mês", "reel"
  valorUnitario   Decimal
  formatoConteudo String? // liga esse serviço a um formato de Conteúdo (reel/story/carrossel/...), pro Escopo mensal calcular contratado x entregue

  itens        ItemOrcamento[]
  pacoteItens  PacoteItem[]
  contratacoes ServicoContratado[]
}

// Registro de horas trabalhadas — dado 100% interno, nunca aparece pro cliente.
model RegistroTempo {
  id        String    @id @default(uuid())
  clienteId String?
  cliente   Cliente?  @relation(fields: [clienteId], references: [id])
  atividade String // ex: "Captação", "Edição", "Reunião"
  inicio    DateTime
  fim       DateTime?
  createdAt DateTime  @default(now())
}

// Serviços que o cliente contratou de fato — o que compõe a mensalidade dele.
// O valor aqui é o valor combinado (pode ter desconto em relação ao catálogo).
model ServicoContratado {
  id         String   @id @default(uuid())
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  servicoId  String
  servico    Servico  @relation(fields: [servicoId], references: [id])
  quantidade Int      @default(1)
  valor      Decimal
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Pacote {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  createdAt DateTime @default(now())

  itens PacoteItem[]
}

model PacoteItem {
  id         String @id @default(uuid())
  pacoteId   String
  pacote     Pacote  @relation(fields: [pacoteId], references: [id])
  servicoId  String
  servico    Servico @relation(fields: [servicoId], references: [id])
  quantidade Int     @default(1)
}

model Orcamento {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  slug      String   @unique
  status    String   @default("pendente") // pendente | aceito | recusado
  enviadoEm DateTime?
  visualizadoEm DateTime?
  dataAceite DateTime? // congela o momento exato do aceite — a proposta não muda mais depois disso
  createdAt DateTime @default(now())

  itens     ItemOrcamento[]
  contratos Contrato[]
  cobrancas Cobranca[]
}

model ItemOrcamento {
  id          String    @id @default(uuid())
  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id])
  servicoId   String
  servico     Servico   @relation(fields: [servicoId], references: [id])
  quantidade  Int       @default(1)
  valor       Decimal
  // Congelados no momento em que o item foi adicionado ao orçamento — se o nome/descrição
  // do serviço mudar depois no catálogo, essa proposta específica continua mostrando o que
  // foi combinado na hora. Nulo = orçamento antigo, de antes dessa mudança (usa o live join).
  nomeServico      String?
  descricaoServico String?
}

model Contrato {
  id          String     @id @default(uuid())
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id])
  orcamentoId String?
  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id])
  conteudo    String
  status      String     @default("rascunho") // rascunho | enviado | assinado
  createdAt   DateTime   @default(now())
}

model Cobranca {
  id          String     @id @default(uuid())
  clienteId   String
  cliente     Cliente    @relation(fields: [clienteId], references: [id])
  orcamentoId String?
  orcamento   Orcamento? @relation(fields: [orcamentoId], references: [id])
  valor       Decimal
  tipo        String     @default("recorrente") // recorrente | unica
  categoria   String? // ex: "Serviços", "Mensalidades", "Produtos" — texto livre
  dataCompetencia DateTime? // mês a que a receita pertence — se vazio, usa createdAt
  dataRecebimento DateTime? // quando o dinheiro realmente entrou
  vencimento  DateTime?
  status      String     @default("pendente") // pendente | pago | atrasado | cancelado
  createdAt   DateTime   @default(now())
  pagamentos  Pagamento[]
}

model Despesa {
  id                 String   @id @default(uuid())
  clienteId          String?
  cliente            Cliente? @relation(fields: [clienteId], references: [id])
  descricao          String
  valor              Decimal
  tipo               String   @default("flexivel") // fixa | flexivel — mantido pro gráfico existente
  categoriaFinanceira String? // custo | despesa_fixa | despesa_variavel | despesa_financeira | imposto | investimento | transferencia
  categoria          String? // ex: "Aluguel", "Material de escritório" — texto livre
  subcategoria       String?
  status             String   @default("pago") // pendente | pago | atrasado | cancelado
  vencimento         DateTime? // só relevante quando status = pendente/atrasado
  dataPagamento      DateTime? // quando o dinheiro realmente saiu (pode ser diferente da competência)
  recorrente         Boolean  @default(false) // true só na despesa "modelo" — repete todo mês sozinha
  origemRecorrenteId String? // preenchido nas cópias geradas automaticamente todo mês
  data               DateTime @default(now()) // data de competência — mês a que o gasto pertence
  pagamentos         Pagamento[]
}

// Depoimentos fixos — aparecem em toda página de orçamento
model Depoimento {
  id          String  @id @default(uuid())
  nomeCliente String
  texto       String
  ativo       Boolean @default(true)
}

// Configurações gerais da agência — sempre 1 registro só (id fixo "config")
model Configuracao {
  id                    String   @id @default("config")
  whatsappAgencia       String? // formato: 5519999999999 (DDI+DDD+número, só dígitos)
  metaFaturamentoMensal Decimal?
  custoHoraPadrao       Decimal? // usado pra calcular rentabilidade descontando o custo das horas trabalhadas
  templateOnboarding    String[] @default([]) // itens do checklist padrão — se vazio, usa o do documento original
}
